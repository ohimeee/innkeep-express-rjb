# InnKeep Express API — request book
#
# Open in VS Code with the REST Client extension (humao.rest-client), free and
# no account. A "Send Request" link appears above each ### block.
#
# Start the API first:  npm run dev
#
# Requests marked WRITES change the shared team database. Read them before
# clicking.

@baseUrl = http://localhost:3000/api

# {{callbackToken}} comes from .vscode/settings.json, which is gitignored.
# Pick the "local" environment in the status bar. Never paste the token here —
# this file is committed.

# Real ids from the seeded database.
@roomId = 3c098f7a-4ab5-4a17-96e7-890225b9872c
@code = IKX-7265
@reservationId = 237b556a-40e7-41c9-a49a-b9006faaabba


###############################################################################
# Reads — safe, nothing changes
###############################################################################

### Rooms — the whole catalog
GET {{baseUrl}}/rooms

### Rooms — availability search
# Rooms already booked across this range drop out. A checkout on the 12th does
# not collide with a check-in on the 12th.
GET {{baseUrl}}/rooms?checkIn=2026-09-10&checkOut=2026-09-12&guests=2

### Rooms — one room
GET {{baseUrl}}/rooms/{{roomId}}

### Reservations — the admin list
GET {{baseUrl}}/reservations

### Reservations — guest lookup by confirmation code
GET {{baseUrl}}/reservations/code/{{code}}

### Folio — the whole bill
GET {{baseUrl}}/folio/{{code}}

### Dashboard — arrivals, departures, occupancy
GET {{baseUrl}}/dashboard


###############################################################################
# Guards — these are meant to fail
###############################################################################

### Booking with check-out before check-in — expects 400
POST {{baseUrl}}/reservations
Content-Type: application/json

{
  "roomId": "{{roomId}}",
  "guestName": "Test Guest",
  "guestCount": 2,
  "checkIn": "2033-05-10",
  "checkOut": "2033-05-09"
}

### Charge with a nonsense amount — expects 400
POST {{baseUrl}}/folio/{{reservationId}}/charges
Content-Type: application/json

{
  "description": "Minibar",
  "department": "FNB",
  "amount": "twelve",
  "postedBy": "rb"
}

### Webhook with no token — expects 401
# The endpoint is public, so this check runs before a single field of the body
# is read.
POST {{baseUrl}}/webhooks/xendit
Content-Type: application/json

{ "status": "PAID", "external_id": "anything" }

### Unknown confirmation code — expects 404
GET {{baseUrl}}/folio/IKX-0000


###############################################################################
# WRITES — these change real data
###############################################################################

### Book a room — WRITES, and opens a live Xendit invoice
# Holds the room as PENDING for 15 minutes and returns invoiceUrl. Use a
# far-future date so it cannot collide with a real booking, and note the
# confirmationCode that comes back — the requests below want its id.
POST {{baseUrl}}/reservations
Content-Type: application/json

{
  "roomId": "{{roomId}}",
  "guestName": "REST Client Test",
  "guestCount": 2,
  "checkIn": "2033-06-10",
  "checkOut": "2033-06-12"
}

### Add a room — WRITES
POST {{baseUrl}}/rooms
Content-Type: application/json

{
  "number": "999",
  "name": "Test Room",
  "type": "STANDARD",
  "capacity": 2,
  "nightlyRate": "3000",
  "status": "AVAILABLE",
  "amenities": ["Twin beds"],
  "description": "Created from the request book",
  "imageUrl": null
}

### Update a room — WRITES
# The body is room 104 exactly as seeded, so this is a no-op unless you edit it.
PUT {{baseUrl}}/rooms/{{roomId}}
Content-Type: application/json

{
  "number": "104",
  "name": "Harbor Standard",
  "type": "STANDARD",
  "capacity": 2,
  "nightlyRate": "4200",
  "status": "AVAILABLE",
  "amenities": ["Twin beds", "City view"],
  "description": "Twin beds | City view | Sleeps 2",
  "imageUrl": null
}

### Check in — WRITES
# Moves the reservation to CHECKED_IN and the room to OCCUPIED in one
# transaction. Refused unless the booking is CONFIRMED.
POST {{baseUrl}}/reservations/{{reservationId}}/check-in

### Post an incidental — WRITES
# VAT-inclusive. Only a checked-in or departed guest can be charged.
POST {{baseUrl}}/folio/{{reservationId}}/charges
Content-Type: application/json

{
  "description": "Minibar — soft drinks",
  "department": "FNB",
  "amount": "450",
  "postedBy": "rb"
}

### Record a payment at the desk — WRITES
POST {{baseUrl}}/folio/{{reservationId}}/payments
Content-Type: application/json

{
  "amount": "450",
  "method": "CASH",
  "cardLast4": null
}

### Check out — WRITES
# Refused while a balance is owed; the error names the amount.
POST {{baseUrl}}/reservations/{{reservationId}}/check-out

### Webhook with the real token — WRITES
# This is what confirms a booking. Point external_id at a PENDING reservation.
POST {{baseUrl}}/webhooks/xendit
Content-Type: application/json
x-callback-token: {{callbackToken}}

{
  "id": "test-invoice-1",
  "external_id": "{{reservationId}}",
  "status": "PAID",
  "payment_channel": "GCASH",
  "paid_at": "2026-09-07T02:00:00.000Z"
}
