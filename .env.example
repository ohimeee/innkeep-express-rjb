# Shared Supabase Postgres — ask the team. Use the SESSION POOLER string
# from Dashboard > Connect; the direct one is IPv6-only and times out.
# Treat it as a password: full read/write on the team's data.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

PORT=4000

# Signs staff login tokens. Any long random string.
JWT_SECRET=

# Xendit test mode. Settings > Developers. Never behind a public prefix.
XENDIT_SECRET_KEY=xnd_development_...
XENDIT_CALLBACK_TOKEN=

# Where Xendit sends the guest back to, and posts webhooks.
# In development this is your tunnel URL, never localhost.
APP_URL=http://localhost:5173
